# Copy values into your runtime environment. Never put a secret in VITE_* variables.
API_PORT=3001
# Optional AI assistant. Node: node --env-file=.env server/index.mjs
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set when running behind HTTPS in production:
# NODE_ENV=production
# APP_ORIGIN=https://your-host.example
