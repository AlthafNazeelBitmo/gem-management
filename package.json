{
  "name": "gem-management-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test server/domain.test.mjs",
    "test:e2e": "playwright test",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test:api": "node --test server/domain.test.mjs"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^4.1.12"
  }
}
